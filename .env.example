# ============================================
# MODE
# ============================================
# Set to "paper" until you have real accounts + verified strategies
# Switch to "live" only after >2 weeks of profitable paper trading
TRADING_MODE=paper

# Global daily loss cap (USD). Bot stops trading if daily PnL < -this
DAILY_LOSS_CAP_USD=200

# Max position size per single market (USD)
MAX_POSITION_PER_MARKET_USD=250

# Per-strategy capital allocation (must sum to <= 1.0)
ALLOC_SUM_TO_ONE=0.25
ALLOC_CROSS_PLATFORM=0.30
ALLOC_CRYPTO_LATENCY=0.30
ALLOC_WEATHER=0.15

# ============================================
# POLYMARKET (CLOB on Polygon)
# Get from polymarket.com after KYC
# ============================================
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137

# ============================================
# KALSHI (CFTC-regulated)
# Get from kalshi.com after KYC
# ============================================
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem
KALSHI_HOST=https://api.elections.kalshi.com/trade-api/v2
KALSHI_WSS=wss://api.elections.kalshi.com/trade-api/ws/v2

# ============================================
# DATA FEEDS
# ============================================
# Binance WebSocket (public, no key required)
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# Coinbase WebSocket (public for ticker)
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com

# NOAA forecast API (free, no key)
NOAA_FORECAST_URL=https://api.weather.gov

# ============================================
# SUPABASE
# ============================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# ALERTS
# ============================================
DISCORD_WEBHOOK_URL=
LOG_LEVEL=info

# ============================================
# QUANT SERVICE (Python)
# ============================================
QUANT_SERVICE_URL=http://localhost:8000
